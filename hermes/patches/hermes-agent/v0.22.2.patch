diff --git a/hermes_cli/auth_select.py b/hermes_cli/auth_select.py
new file mode 100644
index 0000000000..b4a7298ca5
--- /dev/null
+++ b/hermes_cli/auth_select.py
@@ -0,0 +1,48 @@
+"""Explicit selection of a stored credential for work and usage display."""
+from dataclasses import replace
+
+from agent.credential_pool import load_pool, get_pool_strategy, STRATEGY_FILL_FIRST
+from hermes_cli import auth as auth_mod
+from hermes_cli.auth_usage_selection import USAGE_LOGIN_SELECTION_KEY, account_email_from_label
+
+
+def auth_select_command(args) -> None:
+    provider = str(args.provider).strip().lower()
+    scope = getattr(args, "scope", "both")
+    pool = load_pool(provider)
+    _, matched, error = pool.resolve_target(args.target)
+    if matched is None:
+        raise SystemExit(f"{error} Provider: {provider}.")
+    if scope in {"work", "both"} and get_pool_strategy(provider) != STRATEGY_FILL_FIRST:
+        raise SystemExit(f"Work selection requires fill_first for {provider}.")
+    if scope in {"usage", "both"} and (provider != "anthropic" or matched.auth_type != "oauth"):
+        raise SystemExit("Usage selection requires a stored Anthropic OAuth credential.")
+    with auth_mod._auth_store_lock():
+        store = auth_mod._load_auth_store()
+        rows = (store.get("credential_pool") or {}).get(provider) or []
+        target = next((r for r in rows if r.get("id") == matched.id), None)
+        if target is None:
+            raise SystemExit("Select a credential owned by the active profile; list credentials again.")
+        email = target.get("account_email") or account_email_from_label(target.get("label"))
+        if scope in {"work", "both"}:
+            ordered = sorted(rows, key=lambda r: r.get("priority", 0))
+            ordered = [target] + [r for r in ordered if r["id"] != matched.id]
+            from agent.credential_pool import PooledCredential, _normalize_pool_priorities
+            entries = [replace(PooledCredential.from_dict(provider, row), priority=i)
+                       for i, row in enumerate(ordered)]
+            _normalize_pool_priorities(provider, entries)
+            if next(e.priority for e in entries if e.id == matched.id) != 0:
+                raise SystemExit("Choose a manually stored credential to set work priority 0.")
+            store["credential_pool"][provider] = [e.to_dict() for e in sorted(entries, key=lambda e: e.priority)]
+        if scope in {"usage", "both"}:
+            choice = {"credential_id": matched.id, "selected_at": auth_mod._utc_now_z(),
+                      "surface": "cli-selection", "source": matched.source}
+            if email:
+                choice["account_email"] = email
+            auth_mod._store_section(store, USAGE_LOGIN_SELECTION_KEY)[provider] = choice
+        auth_mod._save_auth_store(store)
+    print(f"Selected {provider}: {email or matched.label} (id={matched.id}, scope={scope})")
+    if scope in {"work", "both"}:
+        print("Work priority: 0. New credential resolution uses this order; active requests retain their credential.")
+    if scope in {"usage", "both"}:
+        print("Usage display selection saved. Refresh the usage panel to read the selected account.")
diff --git a/hermes_cli/auth_usage_selection.py b/hermes_cli/auth_usage_selection.py
new file mode 100644
index 0000000000..3f9eb7d61a
--- /dev/null
+++ b/hermes_cli/auth_usage_selection.py
@@ -0,0 +1,264 @@
+"""Explicit login or account selection for the usage display (``usage_login_selection``).
+
+The inference pool orders credentials by priority / strategy / cooldowns; the usage display
+must instead show the account the user logged into LAST. Those are different questions, so this
+module keeps a separate, tiny pointer per provider in ``auth.json``::
+
+    "usage_login_selection": {
+        "anthropic": {"credential_id": "2e8412", "login_at": "2026-10-10T01:02:03Z",
+                      "account_email": "...", "surface": "cli"}
+    }
+
+Contract:
+
+* ``record_usage_login_selection`` is called ONLY from an explicit, successful login path (CLI
+  ``hermes auth add``, the ``hermes model``/``hermes setup`` Codex login, the Desktop native login
+  routes). A re-login of the same or a different account replaces the pointer. Nothing else moves
+  it: automatic token refresh, pool rewrites, cooldowns, priority changes and usage polling are
+  all invisible here — none of them is a login.
+* Reads never guess. There is no "latest entry", mtime, priority or ``last_refresh`` fallback: an
+  install with no recorded login gets ``None`` and the caller shows that honestly.
+* ``hermes auth select`` can explicitly select a saved credential through the same pointer.
+  It records ``selected_at``; ``login_at`` is reserved for successful login events.
+* Only public selection ids and account metadata are stored, never token material. Writes go
+  through the auth-store lock + atomic 0600 save; a validation failure leaves the store untouched.
+* Profile scoping follows ``read_credential_pool``: the active profile's store is authoritative,
+  and the global root's pointer is visible only while the profile borrows the global pool for
+  that provider (zero own rows).
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+from typing import Any, Optional
+
+from hermes_cli.auth import (
+    _auth_store_lock,
+    _load_auth_store,
+    _load_global_auth_store,
+    _save_auth_store,
+    _store_section,
+    _utc_now_z,
+    read_credential_pool,
+)
+
+logger = logging.getLogger(__name__)
+
+USAGE_LOGIN_SELECTION_KEY = "usage_login_selection"
+
+# Pool ids are ``uuid4().hex[:6]``; legacy/manual ids may be longer or carry ``-``/``_``.
+_CREDENTIAL_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
+_METADATA_KEYS = frozenset({"account_email", "account_label", "surface", "source"})
+_FORBIDDEN_FRAGMENTS = ("token", "secret", "key", "password", "credential")
+_MAX_METADATA_LEN = 256
+_REDACTED_ENTRY_FIELDS = ("id", "label", "source", "auth_type", "priority")
+
+
+def _normalize_provider(provider: str) -> str:
+    normalized = (provider or "").strip().lower()
+    if not normalized:
+        raise ValueError("provider is required")
+    return normalized
+
+
+def _validate_credential_id(credential_id: Any) -> str:
+    if not isinstance(credential_id, str) or not _CREDENTIAL_ID_RE.match(credential_id.strip()):
+        raise ValueError("credential_id must be a short public pool id (letters, digits, . _ -)")
+    return credential_id.strip()
+
+
+def _validate_metadata(metadata: dict[str, Any]) -> dict[str, str]:
+    cleaned: dict[str, str] = {}
+    for key, value in metadata.items():
+        if key not in _METADATA_KEYS or any(fragment in key.lower() for fragment in _FORBIDDEN_FRAGMENTS):
+            raise ValueError(f"unsupported selection metadata field: {key!r}")
+        if value is None:
+            continue
+        if not isinstance(value, str):
+            raise ValueError(f"selection metadata {key!r} must be a string")
+        value = value.strip()
+        if not value:
+            continue
+        if len(value) > _MAX_METADATA_LEN:
+            raise ValueError(f"selection metadata {key!r} is too long")
+        cleaned[key] = value
+    return cleaned
+
+
+def _selection_in(store: dict[str, Any], provider: str) -> Optional[dict[str, Any]]:
+    section = store.get(USAGE_LOGIN_SELECTION_KEY) if isinstance(store, dict) else None
+    row = section.get(provider) if isinstance(section, dict) else None
+    if not isinstance(row, dict):
+        return None
+    credential_id = row.get("credential_id")
+    if not isinstance(credential_id, str) or not credential_id:
+        return None
+    return dict(row)
+
+
+def _profile_has_own_rows(store: dict[str, Any], provider: str) -> bool:
+    pool = store.get("credential_pool") if isinstance(store, dict) else None
+    rows = pool.get(provider) if isinstance(pool, dict) else None
+    return isinstance(rows, list) and bool(rows)
+
+
+def get_usage_login_selection(provider: str) -> Optional[dict[str, Any]]:
+    """The current explicit display selection for *provider*, or ``None`` when unset.
+
+    Returns the credential id and explicit login/selection timestamp plus public account metadata.
+    Never contains token material. Never infers a selection from pool order, priority, mtime or
+    refresh timestamps.
+    """
+    provider = _normalize_provider(provider)
+    store = _load_auth_store()
+    own = _selection_in(store, provider)
+    if provider in (store.get(USAGE_LOGIN_SELECTION_KEY) or {}):
+        return own  # local logout keeps the profile display logged out
+    if _profile_has_own_rows(store, provider):
+        return None  # the profile owns this provider: the global pointer is not its login
+    return _selection_in(_load_global_auth_store(), provider)
+
+
+def usage_login_selection_was_recorded(provider: str) -> bool:
+    """A saved login/clear marker prevents legacy account substitution."""
+    provider = _normalize_provider(provider)
+    store = _load_auth_store()
+    if provider in (store.get(USAGE_LOGIN_SELECTION_KEY) or {}):
+        return True
+    if _profile_has_own_rows(store, provider):
+        return False
+    return provider in (_load_global_auth_store().get(USAGE_LOGIN_SELECTION_KEY) or {})
+
+
+def record_usage_login_selection(
+    provider: str, credential_id: str, *, login_at: Optional[str] = None, **metadata: Any,
+) -> dict[str, Any]:
+    """Point the usage display at *credential_id* after an explicit, successful login.
+
+    ``metadata`` accepts ``account_email``, ``account_label``, ``surface`` (``cli``/``desktop``/
+    ``migration``) and ``source``; anything else — in particular anything token-like — raises
+    ``ValueError`` before the store is touched. Returns the stored selection.
+    """
+    provider = _normalize_provider(provider)
+    credential_id = _validate_credential_id(credential_id)
+    cleaned = _validate_metadata(metadata)
+    selection: dict[str, Any] = {"credential_id": credential_id, "login_at": login_at or _utc_now_z(), **cleaned}
+    with _auth_store_lock():
+        store = _load_auth_store()
+        _store_section(store, USAGE_LOGIN_SELECTION_KEY)[provider] = dict(selection)
+        _save_auth_store(store)
+    logger.info("usage login selection for %s -> credential %s (%s)", provider, credential_id,
+                cleaned.get("surface") or "unspecified surface")
+    return selection
+
+
+def clear_usage_login_selection(provider: str, *, credential_id: Optional[str] = None) -> bool:
+    """Drop the pointer for *provider*; with *credential_id* only when it names that credential
+    (the ``hermes auth remove`` / Desktop DELETE hook). Returns whether anything was removed."""
+    provider = _normalize_provider(provider)
+    with _auth_store_lock():
+        store = _load_auth_store()
+        current = get_usage_login_selection(provider)
+        if current is None or (credential_id is not None and current["credential_id"] != credential_id):
+            return False
+        _store_section(store, USAGE_LOGIN_SELECTION_KEY)[provider] = {"cleared_at": _utc_now_z()}
+        _save_auth_store(store)
+    return True
+
+
+def _redacted(row: Any) -> dict[str, Any]:
+    getter = row.get if isinstance(row, dict) else lambda field, default=None: getattr(row, field, default)
+    return {field: getter(field) for field in _REDACTED_ENTRY_FIELDS}
+
+
+def _is_seeded_source(source: Any) -> bool:
+    """Singleton-seeded rows (``device_code``, ``hermes_pkce``, ...) are unique per source by
+    construction (``_upsert_entry`` dedupes on it); ``manual*`` rows are not."""
+    return isinstance(source, str) and bool(source) and not source.startswith("manual")
+
+
+def resolve_usage_login_entry(provider: str) -> Optional[dict[str, Any]]:
+    """The pool row the recorded selection names, REDACTED (id, label, source, auth_type,
+    priority), or ``None`` when nothing is recorded or the row left the pool.
+
+    A selection recorded from a singleton login also carries its seeded ``source``; when the id is
+    not on disk (a named profile borrowing the root pool never materializes its own seeded row, so
+    that row's id is regenerated per load) the unique row with that source is the same credential.
+    """
+    provider = _normalize_provider(provider)
+    selection = get_usage_login_selection(provider)
+    if selection is None:
+        return None
+    for row in read_credential_pool(provider):
+        if isinstance(row, dict) and row.get("id") == selection["credential_id"]:
+            return _redacted(row)
+    source = selection.get("source")
+    if not _is_seeded_source(source):
+        return None
+    from agent.credential_pool import load_pool
+    entry = next((e for e in load_pool(provider).entries() if e.source == source), None)
+    return _redacted(entry) if entry is not None else None
+
+
+def seed_usage_login_selection_if_absent(
+    provider: str, credential_id: str, **metadata: Any,
+) -> Optional[dict[str, Any]]:
+    """One-time explicit migration: record *credential_id* only when NO selection exists yet AND
+    the id is a row of the provider's pool. The caller supplies the id from verified evidence;
+    this function never derives one. Returns the stored selection, or ``None`` when skipped."""
+    provider = _normalize_provider(provider)
+    credential_id = _validate_credential_id(credential_id)
+    if get_usage_login_selection(provider) is not None:
+        return None
+    if not any(isinstance(r, dict) and r.get("id") == credential_id for r in read_credential_pool(provider)):
+        return None
+    cleaned = _validate_metadata({"surface": "migration", **metadata})
+    with _auth_store_lock():
+        if usage_login_selection_was_recorded(provider):
+            return None
+        store = _load_auth_store()
+        selection = {"credential_id": credential_id, "login_at": _utc_now_z(), **cleaned}
+        _store_section(store, USAGE_LOGIN_SELECTION_KEY)[provider] = selection
+        _save_auth_store(store)
+    return dict(selection)
+
+
+def account_email_from_label(label: Any) -> Optional[str]:
+    """A pool label is the token's e-mail claim when one exists; pass it through as account metadata."""
+    return label.strip() if isinstance(label, str) and "@" in label else None
+
+
+def record_pool_entry_login_selection(provider: str, entry: Any, *, surface: str) -> Optional[dict[str, Any]]:
+    """Record a just-added ``PooledCredential`` as the last login. Failures are logged, never raised:
+    the credential IS saved at this point and a metadata hiccup must not fail the login."""
+    try:
+        return record_usage_login_selection(
+            provider, entry.id, surface=surface, source=getattr(entry, "source", None),
+            account_email=account_email_from_label(getattr(entry, "label", None)))
+    except Exception:
+        logger.warning("could not record usage login selection for %s", provider, exc_info=True)
+        return None
+
+
+def record_singleton_login_selection(
+    provider: str, *, surface: str, source: str = "device_code",
+) -> Optional[dict[str, Any]]:
+    """Record the pool row seeded from a provider's ``providers.<id>`` singleton as the last login.
+
+    ``hermes model``/``hermes setup`` and the Desktop device-code route save the Codex/xAI
+    singleton; ``load_pool`` surfaces it as the ``device_code`` row whose id is stable across
+    re-logins. Returns ``None`` (without raising) when no such row exists.
+    """
+    try:
+        from agent.credential_pool import load_pool
+        provider = _normalize_provider(provider)
+        entry = next((e for e in load_pool(provider).entries() if e.source == source), None)
+        if entry is None:
+            return None
+        return record_usage_login_selection(
+            provider, entry.id, surface=surface, source=source,
+            account_email=account_email_from_label(entry.label))
+    except Exception:
+        logger.warning("could not record singleton usage login selection for %s", provider, exc_info=True)
+        return None
