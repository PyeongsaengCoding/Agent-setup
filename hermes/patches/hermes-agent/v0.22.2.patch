+"""Desktop (dashboard backend) native login routes record the last-successful-login selection.
+
+Two native Desktop paths create or re-authenticate a credential without the CLI:
+``_codex_full_login_worker`` (OpenAI Codex device-code login; saves the singleton that
+``load_pool`` surfaces as the ``device_code`` pool row) and ``POST /api/credentials/pool``
+(API-key add). Both must stamp ``usage_login_selection`` in the REQUESTED profile's store, and
+a cancelled/failed login must not.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import httpx
+import pytest
+from fastapi.testclient import TestClient
+
+from hermes_cli.web_server import _SESSION_TOKEN, app
+import hermes_cli.web_routers.oauth as _rt_oauth
+import hermes_cli.web_server_oauth as _web_server_oauth
+from hermes_cli.auth_usage_selection import USAGE_LOGIN_SELECTION_KEY
+
+client = TestClient(app)
+HEADERS = {"X-Hermes-Session-Token": _SESSION_TOKEN}
+
+
+@pytest.fixture()
+def homes(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    root = tmp_path / "hermes"  # not Path.home()/.hermes: the auth seat belt refuses that path
+    root.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    profile_home = root / "profiles" / "coder"
+    profile_home.mkdir(parents=True)
+    (profile_home / "config.yaml").write_text("{}\n")  # identity marker
+    return {"root": root, "coder": profile_home}
+
+
+def _selection(home: Path, provider: str):
+    store = json.loads((home / "auth.json").read_text())
+    return store.get(USAGE_LOGIN_SELECTION_KEY, {}).get(provider)
+
+
+def _codex_clients(access_token: str):
+    class _Resp:
+        def __init__(self, status_code, payload):
+            self.status_code = status_code
+            self._payload = payload
+
+        def json(self):
+            return self._payload
+
+    class _Client:
+        def __init__(self, *args, **kwargs):
+            pass
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *args):
+            return False
+
+        def post(self, url, **kwargs):
+            if url.endswith("/deviceauth/usercode"):
+                return _Resp(200, {"device_auth_id": "device-auth-id", "interval": 0, "user_code": "CODEX-1234"})
+            return _Resp(200, {"authorization_code": "auth-code", "code_verifier": "verifier"})
+
+    class _TokenClient(_Client):
+        def post(self, url, **kwargs):
+            return _Resp(200, {"access_token": access_token, "refresh_token": f"{access_token}-r"})
+
+    return iter([_Client, _Client, _TokenClient])
+
+
+def _run_codex_worker(monkeypatch, access_token: str, profile: str = "coder") -> None:
+    from hermes_cli import web_server as ws
+
+    clients = _codex_clients(access_token)
+    monkeypatch.setattr(httpx, "Client", lambda *a, **k: next(clients)(*a, **k))
+    monkeypatch.setattr(ws.time, "sleep", lambda *_a, **_k: None)
+    sid, _ = _rt_oauth._new_oauth_session("openai-codex", "device_code", profile=profile)
+    try:
+        _rt_oauth._codex_full_login_worker(sid)
+        assert _web_server_oauth._oauth_sessions[sid]["status"] == "approved"
+    finally:
+        _web_server_oauth._oauth_sessions.pop(sid, None)
+
+
+def test_codex_device_login_records_device_code_row_in_launch_profile(homes, monkeypatch):
+    from hermes_cli.auth import read_credential_pool
+
+    _run_codex_worker(monkeypatch, "codex-at-1", profile=None)
+
+    selection = _selection(homes["root"], "openai-codex")
+    assert selection is not None
+    row = next(r for r in read_credential_pool("openai-codex") if r["source"] == "device_code")
+    assert selection["credential_id"] == row["id"]
+    assert selection["surface"] == "desktop"
+    assert selection["source"] == "device_code"
+    assert "codex-at-1" not in json.dumps(selection)
+    assert not (homes["coder"] / "auth.json").exists()
+
+    # A second Desktop login (another account) re-points the SAME seeded row with a fresh stamp.
+    monkeypatch.setattr("hermes_cli.auth_usage_selection._utc_now_z", lambda: "2099-01-01T00:00:00Z")
+    _run_codex_worker(monkeypatch, "codex-at-2", profile=None)
+    again = _selection(homes["root"], "openai-codex")
+    assert again["credential_id"] == row["id"]
+    assert again["login_at"] == "2099-01-01T00:00:00Z"
+
+
+def test_codex_device_login_for_named_profile_scopes_pointer_to_that_profile(homes, monkeypatch):
+    """A named profile's Codex singleton is its own grant: the pointer lands in the profile store,
+    never the launch profile's. Pre-existing pool behaviour: a profile without its own
+    ``credential_pool.openai-codex`` rows never materializes the seeded row, so its id is not
+    stable across loads — the recorded ``source`` lets ``resolve_usage_login_entry`` still name
+    the (unique) singleton row."""
+    from hermes_cli.web_server_profiles import _profile_scope
+    from hermes_cli.auth_usage_selection import get_usage_login_selection, resolve_usage_login_entry
+
+    _run_codex_worker(monkeypatch, "codex-at-1", profile="coder")
+
+    assert not (homes["root"] / "auth.json").exists()
+    selection = _selection(homes["coder"], "openai-codex")
+    assert selection["surface"] == "desktop" and selection["source"] == "device_code"
+    with _profile_scope("coder"):
+        assert get_usage_login_selection("openai-codex") == selection
+        resolved = resolve_usage_login_entry("openai-codex")
+    assert resolved is not None and resolved["source"] == "device_code"
+    assert "access_token" not in resolved
+    assert "codex-at-1" not in json.dumps(resolved)
+
+
+def test_codex_device_login_cancelled_before_save_records_nothing(homes, monkeypatch):
+    from hermes_cli import auth as auth_mod
+    from hermes_cli import web_server as ws
+
+    clients = _codex_clients("codex-at-x")
+    monkeypatch.setattr(httpx, "Client", lambda *a, **k: next(clients)(*a, **k))
+    monkeypatch.setattr(ws.time, "sleep", lambda *_a, **_k: None)
+    saved = []
+    monkeypatch.setattr(auth_mod, "_save_codex_tokens", lambda tokens: saved.append(tokens))
+    sid, sess = _rt_oauth._new_oauth_session("openai-codex", "device_code", profile="coder")
+    sess["cancelled"] = True
+    try:
+        _rt_oauth._codex_full_login_worker(sid)
+    finally:
+        _web_server_oauth._oauth_sessions.pop(sid, None)
+    assert saved == []
+    assert not (homes["coder"] / "auth.json").exists()
+
+
+def test_pool_api_key_post_records_selection_for_profile(homes):
+    resp = client.post("/api/credentials/pool?profile=coder", headers=HEADERS,
+                       json={"provider": "anthropic", "api_key": "«redacted:sk-…»", "label": "desk"})
+    assert resp.status_code == 200, resp.text
+
+    store = json.loads((homes["coder"] / "auth.json").read_text())
+    row = next(r for r in store["credential_pool"]["anthropic"] if r["label"] == "desk")
+    selection = store[USAGE_LOGIN_SELECTION_KEY]["anthropic"]
+    assert selection["credential_id"] == row["id"]
+    assert selection["surface"] == "desktop"
+    assert "sk-ant" not in json.dumps(selection)
+    assert not (homes["root"] / "auth.json").exists()
+
+
+def test_pool_delete_clears_pointer_only_for_removed_row(homes):
+    client.post("/api/credentials/pool?profile=coder", headers=HEADERS,
+                json={"provider": "anthropic", "api_key": "sk-ant-one", "label": "one"})
+    client.post("/api/credentials/pool?profile=coder", headers=HEADERS,
+                json={"provider": "anthropic", "api_key": "sk-ant-two", "label": "two"})
+    store = json.loads((homes["coder"] / "auth.json").read_text())
+    rows = store["credential_pool"]["anthropic"]
+    two = next(r for r in rows if r["label"] == "two")
+    assert store[USAGE_LOGIN_SELECTION_KEY]["anthropic"]["credential_id"] == two["id"]
+
+    listed = client.get("/api/credentials/pool?profile=coder", headers=HEADERS).json()
+    entries = next(p for p in listed["providers"] if p["provider"] == "anthropic")["entries"]
+    idx_one = next(e["index"] for e in entries if e["label"] == "one")
+    resp = client.delete(f"/api/credentials/pool/anthropic/{idx_one}?profile=coder", headers=HEADERS)
+    assert resp.status_code == 200, resp.text
+    assert _selection(homes["coder"], "anthropic")["credential_id"] == two["id"]
+
+    listed = client.get("/api/credentials/pool?profile=coder", headers=HEADERS).json()
+    entries = next(p for p in listed["providers"] if p["provider"] == "anthropic")["entries"]
+    idx_two = next(e["index"] for e in entries if e["label"] == "two")
+    resp = client.delete(f"/api/credentials/pool/anthropic/{idx_two}?profile=coder", headers=HEADERS)
+    assert resp.status_code == 200, resp.text
+    cleared = _selection(homes["coder"], "anthropic")
+    assert cleared.get("credential_id") is None
+    assert cleared["cleared_at"]
