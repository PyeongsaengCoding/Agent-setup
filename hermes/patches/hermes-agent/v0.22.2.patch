diff --git a/tests/agent/test_auxiliary_pool_model_cooldowns.py b/tests/agent/test_auxiliary_pool_model_cooldowns.py
new file mode 100644
index 0000000000..135e999a4c
--- /dev/null
+++ b/tests/agent/test_auxiliary_pool_model_cooldowns.py
@@ -0,0 +1,143 @@
+"""Auxiliary 429 recovery must not turn a model throttle into an account outage.
+
+Real pool selection, rotation and auth-store persistence under an isolated Hermes
+home; only client construction and the provider request are replaced (no network).
+"""
+import asyncio
+from types import SimpleNamespace
+from typing import Any
+
+import httpx
+import pytest
+
+import agent.auxiliary_client as aux
+from agent.credential_pool import CredentialPool, PooledCredential
+from hermes_cli.auth import read_credential_pool
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+MODEL = "claude-haiku-test"
+SIBLING = "claude-opus-test"
+NOW = 1_800_000_000.0
+BASE = "https://api.anthropic.com"
+
+
+class _Limited(Exception):
+    def __init__(self, headers=None, message="This request would exceed your account's rate limit."):
+        super().__init__(message)
+        self.status_code = 429
+        self.response = httpx.Response(429, headers=headers or {})
+
+
+@pytest.fixture
+def pool_home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    token = set_hermes_home_override(tmp_path)
+    monkeypatch.setattr("time.time", lambda: NOW)
+    pool = CredentialPool(provider="anthropic", entries=[
+        PooledCredential.from_dict("anthropic", {
+            "id": f"seat{i}", "label": f"seat-{i}", "auth_type": "api_key",
+            "priority": i, "access_token": f"test-key-{i}", "base_url": BASE,
+            "source": "manual", "model_cooldowns": {"existing-model": NOW + 7200},
+        }) for i in range(3)
+    ])
+    pool._persist()
+    monkeypatch.setattr(aux, "load_pool", lambda provider: pool)
+    monkeypatch.setattr(aux, "_client_cache", {})
+    try:
+        yield pool
+    finally:
+        reset_hermes_home_override(token)
+
+
+@pytest.mark.parametrize("async_mode", [False, True], ids=["sync", "async"])
+def test_rotated_429s_only_bench_the_wire_model(pool_home, monkeypatch, async_mode):
+    pool = pool_home
+    builds = []
+    requests = []
+
+    def build(token, base_url):
+        builds.append(token)
+        return SimpleNamespace(api_key=token, base_url=base_url)
+
+    def request(client, kwargs, **ignored):
+        requests.append((client.api_key, kwargs["model"]))
+        # A default changes mid-flight: recovery must keep the model that failed.
+        monkeypatch.setattr(aux, "_get_aux_model_for_provider", lambda provider: SIBLING)
+        if client.api_key == "test-key-1":
+            # Another request moves current() before this rotated request fails.
+            pool.select(model=SIBLING)
+        raise _Limited({"Retry-After": "7"})
+
+    async def async_request(*args, **kwargs):
+        return request(*args, **kwargs)
+
+    monkeypatch.setattr("agent.anthropic_adapter.build_anthropic_client", build)
+    monkeypatch.setattr("agent.anthropic_credentials.resolve_anthropic_token", lambda: None)
+    monkeypatch.setattr(aux, "_get_aux_model_for_provider", lambda provider: MODEL)
+    monkeypatch.setattr(aux, "_relay_sync_completion", request)
+    monkeypatch.setattr(aux, "_relay_async_completion", async_request)
+    monkeypatch.setattr(aux, "_try_configured_fallback_chain", lambda *a, **k: (None, None, ""))
+    monkeypatch.setattr(aux, "_try_main_agent_model_fallback", lambda *a, **k: (None, None, ""))
+    call: dict[str, Any] = dict(
+        task="title_generation", provider="anthropic", messages=[{"role": "user", "content": "Title"}],
+    )
+    with pytest.raises(_Limited):
+        if async_mode:
+            asyncio.run(aux.async_call_llm(**call))
+        else:
+            aux.call_llm(**call)
+
+    assert requests == [("test-key-0", MODEL), ("test-key-0", MODEL), ("test-key-1", MODEL)]
+    assert builds == ["test-key-0", "test-key-1"]
+    rows = {row["id"]: row for row in read_credential_pool("anthropic")}
+    for seat in ("seat0", "seat1"):
+        assert rows[seat].get("last_status") != "exhausted", "a title 429 must not poison the account"
+        assert rows[seat]["model_cooldowns"][MODEL] == NOW + 7
+        assert rows[seat]["model_cooldowns"]["existing-model"] == NOW + 7200
+    assert MODEL not in rows["seat2"]["model_cooldowns"]
+    assert pool.has_available(model=SIBLING)
+    assert pool.select(model=MODEL).id == "seat2"
+
+
+@pytest.mark.parametrize("reset_source", ["header", "body", "message", "absent", "existing-longer"])
+def test_model_cooldown_honors_reset_without_clearing_other_limits(pool_home, reset_source):
+    pool = pool_home
+    entry = pool.select(model=MODEL)
+    exc = _Limited()
+    expected = NOW + 7
+    if reset_source == "header":
+        exc = _Limited({"retry-after": "7"})
+    elif reset_source == "body":
+        exc.body = {"error": {"message": str(exc), "resets_at": expected}}
+    elif reset_source == "message":
+        exc = _Limited(message="Rate limit exceeded; retry after 7 seconds")
+    elif reset_source == "absent":
+        expected = NOW + 3600  # Keep the pool's conservative default policy.
+    else:
+        expected = NOW + 900
+        pool._adopt(entry, model_cooldowns={MODEL: expected, "existing-model": NOW + 7200})
+        exc = _Limited({"Retry-After": "7"})
+
+    assert aux._recover_provider_pool("anthropic", exc, failed_api_key=entry.runtime_api_key, model=MODEL)
+
+    rows = {row["id"]: row for row in read_credential_pool("anthropic")}
+    assert rows["seat0"].get("last_status") != "exhausted"
+    assert rows["seat0"]["model_cooldowns"][MODEL] == expected
+    assert rows["seat0"]["model_cooldowns"]["existing-model"] == NOW + 7200
+    assert pool.has_available(model=SIBLING)
+
+
+@pytest.mark.parametrize("status,message", [
+    (401, "Unauthorized"), (402, "Insufficient credits"), (429, "insufficient_quota"),
+])
+def test_auth_and_payment_still_bench_the_whole_credential(pool_home, status, message):
+    pool = pool_home
+    entry = pool.select(model=MODEL)
+    exc = _Limited(message=message)
+    exc.status_code = status
+    aux._recover_provider_pool("anthropic", exc, failed_api_key=entry.runtime_api_key, model=MODEL)
+
+    row = next(row for row in read_credential_pool("anthropic") if row["id"] == entry.id)
+    assert row["last_status"] == "exhausted"
+    assert MODEL not in row["model_cooldowns"]
+    assert pool.select(model=SIBLING).id != entry.id
diff --git a/tests/agent/test_rate_limit_rotation_model_scoped.py b/tests/agent/test_rate_limit_rotation_model_scoped.py
new file mode 100644
index 0000000000..2c6836507e
--- /dev/null
+++ b/tests/agent/test_rate_limit_rotation_model_scoped.py
@@ -0,0 +1,118 @@
+"""A per-model Anthropic 429 rotates through every account before the provider fallback activates.
+
+The eager rate-limit fallback (``route_classified_error``) waits while credential-pool rotation
+may still recover. Asking the pool without the model honours every model's cooldown: one cooled
+sibling model on every account made the pool look empty, so the first 429 for the configured
+model jumped straight to the fallback provider while two accounts could still serve it.
+
+Real ``CredentialPool`` + real rotation (``recover_with_credential_pool``) + real classifier and
+eager-fallback router; only the agent object is a stand-in (no client build, no network).
+"""
+import time
+
+from agent.agent_runtime_helpers import recover_with_credential_pool
+from agent.credential_pool import CredentialPool, PooledCredential
+from agent.error_classifier import classify_api_error
+from agent.turn_recovery import route_classified_error
+from agent.turn_retry_state import TurnRetryState
+
+_BASE = "https://api.anthropic.com"
+PRIMARY_MODEL = "claude-opus-5-5"
+SIBLING_MODEL = "claude-fable-5-1"
+SEAT_KEYS = ("sk-ant-api03-seat-one", "sk-ant-api03-seat-two", "sk-ant-api03-seat-three")
+
+
+class _RateLimited(Exception):
+    status_code = 429
+
+
+class _Agent:
+    """Session stand-in carrying exactly the state the rotation and router read."""
+
+    provider = "anthropic"
+    base_url = _BASE
+    model = PRIMARY_MODEL
+    api_mode = "anthropic_messages"
+    log_prefix = ""
+    compression_enabled = True
+
+    def __init__(self, pool):
+        self._credential_pool = pool
+        first = pool.select(model=PRIMARY_MODEL)
+        self.api_key = first.runtime_api_key
+        self._credential_pool_entry_id = first.id
+        self._fallback_chain = [{"provider": "openai-codex", "model": "gpt-6.1-sol"}]
+        self._fallback_index = 0
+        self.fallback_activations = 0
+        self.statuses = []
+
+    def _swap_credential(self, entry):
+        self.api_key = entry.runtime_api_key
+        self._credential_pool_entry_id = entry.id
+        return True
+
+    def _is_entitlement_failure(self, error_context, status_code):
+        return False
+
+    def _buffer_diagnostic_status(self, line):
+        self.statuses.append(line)
+
+    def _try_activate_fallback(self, **_kwargs):
+        self.fallback_activations += 1
+        return False  # keep the router on its fall-through path; the call itself is the evidence
+
+    def _vprint(self, *_args, **_kwargs):
+        pass
+
+
+def _pool(cooled_models):
+    until = time.time() + 3600
+    return CredentialPool(provider="anthropic", entries=[
+        PooledCredential.from_dict("anthropic", {
+            "id": f"seat{i}", "label": f"seat-{i}", "auth_type": "api_key", "priority": i,
+            "access_token": key, "base_url": _BASE, "source": "manual",
+            "model_cooldowns": {m: until for m in cooled_models},
+        }) for i, key in enumerate(SEAT_KEYS)])
+
+
+def _opus_429(agent, has_retried_429):
+    """One Opus 429 through the real recovery order: pool recovery first, else the eager router."""
+    error = _RateLimited("This request would exceed your account's rate limit. Please try again later.")
+    classified = classify_api_error(error, provider="anthropic", model=PRIMARY_MODEL, base_url=_BASE)
+    recovered, has_retried_429 = recover_with_credential_pool(
+        agent, status_code=429, has_retried_429=has_retried_429,
+        classified_reason=classified.reason, error_context=classified.error_context)
+    if recovered:
+        return True, False
+    route_classified_error(
+        agent, error, classified, TurnRetryState(), error_msg=str(error),
+        error_context=classified.error_context, recovered_with_pool=False, base_url=_BASE,
+        model=PRIMARY_MODEL, messages=[], api_messages=[], system_message="", active_system_prompt="",
+        conversation_history=[], retry_count=0, max_retries=3, compression_attempts=0,
+        max_compression_attempts=3, api_call_count=1, effective_task_id=None)
+    return False, has_retried_429
+
+
+def test_sibling_model_cooldowns_do_not_skip_rotation_for_the_requested_model():
+    agent = _Agent(_pool([SIBLING_MODEL]))
+
+    _opus_429(agent, has_retried_429=False)
+
+    assert agent.fallback_activations == 0
+
+
+def test_opus_429s_rotate_through_all_three_accounts_before_falling_back():
+    agent = _Agent(_pool([SIBLING_MODEL]))
+    seats_used = [agent._credential_pool_entry_id]
+    has_retried_429 = False
+    for _ in range(12):  # bounded: retry-once + rotate per seat, then the fallback
+        if agent.fallback_activations:
+            break
+        recovered, has_retried_429 = _opus_429(agent, has_retried_429)
+        if recovered:
+            seats_used.append(agent._credential_pool_entry_id)
+
+    assert seats_used == ["seat0", "seat1", "seat2"]
+    assert agent.fallback_activations == 1
+    assert agent._credential_pool.has_available(model=PRIMARY_MODEL) is False
+    assert agent._credential_pool.has_available(model="claude-haiku-5") is True  # other models untouched
diff --git a/tests/gateway/test_gateway_primary_model_scoped_credentials.py b/tests/gateway/test_gateway_primary_model_scoped_credentials.py
new file mode 100644
index 0000000000..f9b149a8b0
--- /dev/null
+++ b/tests/gateway/test_gateway_primary_model_scoped_credentials.py
@@ -0,0 +1,97 @@
+"""Gateway primary credential resolution is scoped to the configured primary MODEL.
+
+Anthropic rate-limits per model, so the pool records a 429 as a cooldown on that model only.
+``gateway.run._resolve_runtime_agent_kwargs`` resolved the primary without naming the model, and
+an unscoped pool selection honours every model's cooldown: one cooled-down sibling model on every
+account blocked the configured model too, and the gateway reported "No Anthropic credentials" or
+fell back to another provider while the requested model was still servable.
+
+Real ``config.yaml`` + ``auth.json`` in a temp ``HERMES_HOME``; real pool, ladder and fallback walker.
+"""
+import json
+import time
+
+import pytest
+
+PRIMARY_MODEL = "claude-opus-5-5"
+SIBLING_MODEL = "claude-fable-5-1"
+FALLBACK_MODEL = "gpt-6.1-sol"
+SEAT_KEYS = ("sk-ant-api03-seat-one", "sk-ant-api03-seat-two", "sk-ant-api03-seat-three")
+
+
+def _anthropic_seat(index: int, cooled_models: tuple[str, ...]) -> dict:
+    until = time.time() + 3600
+    return {
+        "id": f"seat{index}", "label": f"seat-{index}", "auth_type": "api_key", "priority": index,
+        "source": "manual", "access_token": SEAT_KEYS[index],
+        "model_cooldowns": {model: until for model in cooled_models},
+    }
+
+
+@pytest.fixture
+def gateway_home(tmp_path, monkeypatch):
+    """Configured Opus primary on Anthropic, Codex GPT fallback; seats written by the test."""
+    home = tmp_path / "hermes"
+    home.mkdir()
+    fake_user_home = tmp_path / "user"
+    fake_user_home.mkdir()
+    monkeypatch.setenv("HOME", str(fake_user_home))
+    monkeypatch.setenv("CLAUDE_CONFIG_DIR", str(fake_user_home / ".claude"))
+    for var in ("ANTHROPIC_TOKEN", "ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "OPENAI_API_KEY"):
+        monkeypatch.delenv(var, raising=False)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    import hermes_constants
+    hermes_constants._default_hermes_root_memo = None  # type: ignore[attr-defined]
+    import gateway.run as gateway_run
+    monkeypatch.setattr(gateway_run, "_hermes_home", home)
+    (home / "config.yaml").write_text(
+        f"model:\n  default: {PRIMARY_MODEL}\n  provider: anthropic\n"
+        f"fallback_providers:\n  - provider: openai-codex\n    model: {FALLBACK_MODEL}\n")
+
+    def write_seats(*cooled_per_seat: tuple[str, ...]) -> None:
+        (home / "auth.json").write_text(json.dumps({"version": 1, "credential_pool": {
+            "anthropic": [_anthropic_seat(i, cooled) for i, cooled in enumerate(cooled_per_seat)],
+            "openai-codex": [{
+                "id": "codex1", "label": "codex", "auth_type": "oauth", "priority": 0,
+                "source": "manual", "access_token": "codex-access-token", "refresh_token": "codex-refresh",
+            }],
+        }}))
+
+    return write_seats
+
+
+def _resolve():
+    from gateway.run import _resolve_runtime_agent_kwargs
+    return _resolve_runtime_agent_kwargs()
+
+
+def test_sibling_model_cooldown_on_every_seat_leaves_primary_model_on_anthropic(gateway_home):
+    gateway_home((SIBLING_MODEL,), (SIBLING_MODEL,), (SIBLING_MODEL,))
+
+    runtime = _resolve()
+
+    assert runtime["provider"] == "anthropic"
+    assert runtime["api_key"] in SEAT_KEYS
+    assert "_fallback_notice" not in runtime and "model" not in runtime
+
+
+@pytest.mark.parametrize("blocked_seats", [1, 2])
+def test_partially_rate_limited_primary_model_stays_on_a_free_anthropic_seat(gateway_home, blocked_seats):
+    gateway_home(*[(SIBLING_MODEL, PRIMARY_MODEL) if i < blocked_seats else (SIBLING_MODEL,) for i in range(3)])
+
+    runtime = _resolve()
+
+    assert runtime["provider"] == "anthropic"
+    assert runtime["api_key"] in SEAT_KEYS[blocked_seats:]
+    assert "_fallback_notice" not in runtime
+
+
+def test_primary_model_rate_limited_on_every_seat_falls_back_to_configured_gpt(gateway_home):
+    gateway_home(*[(SIBLING_MODEL, PRIMARY_MODEL)] * 3)
+
+    runtime = _resolve()
+
+    assert runtime["provider"] == "openai-codex"
+    assert runtime["model"] == FALLBACK_MODEL
+    assert runtime["api_key"] == "codex-access-token"
+    assert PRIMARY_MODEL in runtime["_fallback_notice"] and FALLBACK_MODEL in runtime["_fallback_notice"]
