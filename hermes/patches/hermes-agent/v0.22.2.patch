+++ b/tests/hermes_cli/test_auth_select.py
@@ -0,0 +1,126 @@
+"""Explicit work/usage credential selection through the public auth command."""
+import argparse
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli.subcommands.auth import build_auth_parser
+from hermes_cli.auth_commands import auth_command
+from hermes_cli.auth import write_credential_pool, read_credential_pool
+from hermes_cli.auth_usage_selection import get_usage_login_selection, record_usage_login_selection
+
+
+@pytest.fixture(autouse=True)
+def isolated(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / "hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for key in ("ANTHROPIC_API_KEY", "ANTHROPIC_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN"):
+        monkeypatch.delenv(key, raising=False)
+    write_credential_pool("anthropic", [
+        dict(id=f"account{i}", label=f"person{i}@example.com", auth_type="oauth",
+             source="manual:hermes_pkce", priority=i, access_token=f"fixture-token-{i}",
+             model_cooldowns={"some-model": 9999999999})
+        for i in range(3)
+    ])
+    record_usage_login_selection("anthropic", "account0", login_at="2026-01-01T00:00:00Z")
+    return home
+
+
+def invoke(*argv):
+    parser = argparse.ArgumentParser()
+    build_auth_parser(parser.add_subparsers(), cmd_auth=auth_command)
+    args = parser.parse_args(["auth", "select", "anthropic", *argv])
+    args.func(args)
+
+
+def test_select_moves_work_and_usage_together(isolated, capsys):
+    invoke("account2")
+    rows = read_credential_pool("anthropic")
+    assert [r["id"] for r in rows] == ["account2", "account0", "account1"]
+    assert [r["priority"] for r in rows] == [0, 1, 2]
+    assert all(r["model_cooldowns"] == {"some-model": 9999999999} for r in rows)
+    choice = get_usage_login_selection("anthropic")
+    assert choice["credential_id"] == "account2"
+    assert choice["account_email"] == "person2@example.com"
+    assert choice["selected_at"]
+    assert "login_at" not in choice
+    output = capsys.readouterr().out
+    assert "person2@example.com" in output
+    assert "fixture-token" not in output
+
+
+@pytest.mark.parametrize("scope", ["work", "usage"])
+def test_independent_scope_preserves_the_other_choice(isolated, scope):
+    before = read_credential_pool("anthropic")
+    old_choice = get_usage_login_selection("anthropic")
+    invoke("2", "--scope", scope)
+    rows = read_credential_pool("anthropic")
+    choice = get_usage_login_selection("anthropic")
+    if scope == "work":
+        assert rows[0]["id"] == "account1"
+        assert choice == old_choice
+    else:
+        assert rows == before
+        assert choice["credential_id"] == "account1"
+
+
+def test_invalid_target_leaves_store_unchanged(isolated):
+    before = (isolated / "auth.json").read_bytes()
+    with pytest.raises(SystemExit, match="No credential"):
+        invoke("missing-id")
+    assert (isolated / "auth.json").read_bytes() == before
+
+
+def test_selection_write_failure_keeps_both_choices(isolated, monkeypatch):
+    from hermes_cli import auth as auth_mod
+    before = (isolated / "auth.json").read_bytes()
+    def fail(store):
+        raise OSError("fixture failed save")
+    monkeypatch.setattr(auth_mod, "_save_auth_store", fail)
+    with pytest.raises(OSError, match="failed save"):
+        invoke("account2")
+    assert (isolated / "auth.json").read_bytes() == before
+
+
+def test_native_resolver_uses_selected_work_credential(isolated):
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+    invoke("account2")
+    runtime = resolve_runtime_provider(requested="anthropic", target_model="claude-opus-5-5")
+    assert runtime["api_key"] == "fixture-token-2"
+
+
+def test_explicit_selection_preserves_other_provider_metadata(isolated):
+    record_usage_login_selection("openai-codex", "codex0", login_at="2026-01-02T00:00:00Z")
+    old = get_usage_login_selection("openai-codex")
+    invoke("account1")
+    assert get_usage_login_selection("openai-codex") == old
+
+
+def test_list_shows_cached_email_and_usage_choice(isolated, capsys):
+    from types import SimpleNamespace
+    from hermes_cli.auth_commands import auth_list_command
+    rows = read_credential_pool("anthropic")
+    rows[1]["label"] = "generic-oauth-label"
+    rows[1]["account_email"] = "display-account@example.com"
+    write_credential_pool("anthropic", rows)
+    record_usage_login_selection("anthropic", "account1")
+    auth_list_command(SimpleNamespace(provider="anthropic"))
+    output = capsys.readouterr().out
+    assert "display-account@example.com" in output
+    assert "usage" in next(line for line in output.splitlines() if "id=account1" in line)
+
+
+def test_profile_without_own_pool_cannot_reorder_root(isolated, monkeypatch, tmp_path):
+    root_before = (isolated / "auth.json").read_bytes()
+    profile = tmp_path / "named-profile"
+    profile.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(profile))
+    from hermes_cli import auth as auth_mod
+    monkeypatch.setattr(auth_mod, "_load_global_auth_store",
+                        lambda: json.loads(root_before))
+    with pytest.raises(SystemExit):
+        invoke("account2")
+    assert (isolated / "auth.json").read_bytes() == root_before
diff --git a/tests/hermes_cli/test_auth_usage_selection.py b/tests/hermes_cli/test_auth_usage_selection.py
new file mode 100644
index 0000000000..416d88862a
--- /dev/null
+++ b/tests/hermes_cli/test_auth_usage_selection.py
@@ -0,0 +1,402 @@
+"""Last-successful-login selection metadata (``usage_login_selection`` in auth.json).
+
+The provider-usage display must show the account the user logged into LAST, not whichever
+pooled credential sits at priority 0 / was refreshed most recently. The pointer is written
+only by an explicit, successful login (CLI ``hermes auth add`` and the Desktop native login
+routes) and is never touched by token refresh, pool rewrites or usage polling. Inference
+rotation (priority / fallback / cooldowns) is untouched by this metadata.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import auth as auth_mod
+from hermes_cli.auth import read_credential_pool, write_credential_pool
+from hermes_cli.auth_usage_selection import (
+    USAGE_LOGIN_SELECTION_KEY,
+    clear_usage_login_selection,
+    get_usage_login_selection,
+    record_singleton_login_selection,
+    record_usage_login_selection,
+    resolve_usage_login_entry,
+    seed_usage_login_selection_if_absent,
+)
+
+
+@pytest.fixture(autouse=True)
+def _isolated_home(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / "hermes"  # not Path.home()/.hermes: the auth seat belt refuses that path
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    for key in ("ANTHROPIC_API_KEY", "ANTHROPIC_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN", "OPENAI_API_KEY"):
+        monkeypatch.delenv(key, raising=False)
+    return home
+
+
+def _anthropic_rows() -> list[dict]:
+    return [
+        dict(id=f"ant{i}", label=f"claude{i}@example.com", source="manual:hermes_pkce",
+             auth_type="oauth", access_token=f"fixture-access-{i}",
+             refresh_token=f"fixture-refresh-{i}", priority=i)
+        for i in range(4)
+    ]
+
+
+def _raw_store(home: Path) -> dict:
+    return json.loads((home / "auth.json").read_text())
+
+
+# --------------------------------------------------------------------------- core contract
+
+
+def test_get_returns_none_when_nothing_recorded(_isolated_home):
+    write_credential_pool("anthropic", _anthropic_rows())
+    assert get_usage_login_selection("anthropic") is None
+
+
+def test_record_then_get_roundtrip_without_secrets(_isolated_home):
+    write_credential_pool("anthropic", _anthropic_rows())
+
+    recorded = record_usage_login_selection(
+        "anthropic", "ant2", account_email="f_design@example.com", surface="cli")
+
+    selection = get_usage_login_selection("anthropic")
+    assert selection == recorded
+    assert selection["credential_id"] == "ant2"
+    assert selection["account_email"] == "f_design@example.com"
+    assert selection["surface"] == "cli"
+    assert selection["login_at"].endswith("Z")
+
+    section = _raw_store(_isolated_home)[USAGE_LOGIN_SELECTION_KEY]["anthropic"]
+    dumped = json.dumps(section)
+    assert "fixture-access" not in dumped and "fixture-refresh" not in dumped
+    assert not any("token" in key or "secret" in key for key in section)
+    # Inference policy untouched: order and priorities of the pool are exactly as written.
+    assert [row["id"] for row in read_credential_pool("anthropic")] == ["ant0", "ant1", "ant2", "ant3"]
+    assert [row["priority"] for row in read_credential_pool("anthropic")] == [0, 1, 2, 3]
+
+
+def test_relogin_replaces_pointer_same_or_different_account(_isolated_home, monkeypatch):
+    from hermes_cli import auth_usage_selection as sel
+
+    stamps = iter(["2026-10-01T00:00:00Z", "2026-10-02T00:00:00Z", "2026-10-03T00:00:00Z"])
+    monkeypatch.setattr(sel, "_utc_now_z", lambda: next(stamps))
+
+    record_usage_login_selection("anthropic", "ant0")
+    record_usage_login_selection("anthropic", "ant3", account_email="other@example.com")
+    assert get_usage_login_selection("anthropic") == {
+        "credential_id": "ant3", "login_at": "2026-10-02T00:00:00Z", "account_email": "other@example.com"}
+
+    # Logging into the same account again is still a new login: the timestamp moves forward.
+    record_usage_login_selection("anthropic", "ant3")
+    assert get_usage_login_selection("anthropic") == {
+        "credential_id": "ant3", "login_at": "2026-10-03T00:00:00Z"}
+
+
+def test_providers_are_independent(_isolated_home):
+    record_usage_login_selection("anthropic", "ant1")
+    record_usage_login_selection("openai-codex", "cdx9")
+    assert get_usage_login_selection("anthropic")["credential_id"] == "ant1"
+    assert get_usage_login_selection("openai-codex")["credential_id"] == "cdx9"
+    assert get_usage_login_selection("OpenAI-Codex ")["credential_id"] == "cdx9"  # normalized
+
+
+@pytest.mark.parametrize("bad_id", ["", "   ", None, 42, "x" * 65, "has space", "../etc"])
+def test_invalid_credential_id_is_rejected_and_store_untouched(_isolated_home, bad_id):
+    record_usage_login_selection("anthropic", "ant0")
+    before = _raw_store(_isolated_home)
+    with pytest.raises(ValueError):
+        record_usage_login_selection("anthropic", bad_id)
+    assert _raw_store(_isolated_home) == before
+
+
+def test_secret_like_metadata_is_rejected(_isolated_home):
+    with pytest.raises(ValueError):
+        record_usage_login_selection("anthropic", "ant0", access_token="sk-nope")
