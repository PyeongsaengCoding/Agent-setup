+"""Keep plugin tests inside an isolated Hermes credential scope."""
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture(autouse=True)
+def isolated_hermes_auth(tmp_path, monkeypatch):
+    home = tmp_path / "plugin-hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
