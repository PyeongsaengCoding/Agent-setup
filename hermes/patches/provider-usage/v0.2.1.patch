@@ -0,0 +1,83 @@
+"""Persisted display selection is independent from inference priority."""
+import importlib.util
+from pathlib import Path
+from unittest.mock import patch
+
+import pytest
+
+from hermes_cli.auth import write_credential_pool
+from hermes_cli.auth_usage_selection import record_usage_login_selection, clear_usage_login_selection
+
+
+@pytest.fixture
+def api(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / "hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    write_credential_pool("anthropic", [
+        dict(id="first", label="first", priority=0, source="manual:hermes_pkce",
+             auth_type="oauth", access_token="fixture-first"),
+        dict(id="chosen", label="chosen", priority=1, source="manual:hermes_pkce",
+             auth_type="oauth", access_token="fixture-chosen")])
+    spec = importlib.util.spec_from_file_location("selection_test_api",
+        Path(__file__).resolve().parents[1] / "dashboard" / "plugin_api.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_usage_fetches_saved_selection_even_when_work_priority_differs(api):
+    record_usage_login_selection("anthropic", "chosen", account_email="chosen@example.com")
+    with patch.object(api, "_http_json", return_value={"five_hour": {"utilization": 0.5}}) as get:
+        result = api.fetch_anthropic()
+    assert result.get("credential_id") == "chosen"
+    assert result["windows"][0]["percent"] == 0.5
+    assert get.call_args.args[1]["Authorization"] == "Bearer fixture-chosen"
+    assert result["account_email"] == "chosen@example.com"
+
+
+def test_deleted_selected_credential_does_not_substitute_another_account(api):
+    record_usage_login_selection("anthropic", "missing")
+    with patch.object(api, "_http_json") as get:
+        result = api.fetch_anthropic()
+    assert result["status"] == "unavailable"
+    get.assert_not_called()
+
+
+def test_cached_payload_changes_scope_after_selection(api):
+    from hermes_cli.auth_usage_selection import get_usage_login_selection
+    record_usage_login_selection("anthropic", "first")
+    def collect():
+        return {"selected": get_usage_login_selection("anthropic")["credential_id"]}
+    with patch.object(api, "_collect", side_effect=collect):
+        assert api.payload()["selected"] == "first"
+        record_usage_login_selection("anthropic", "chosen")
+        assert api.payload()["selected"] == "chosen"
+
+
+def test_collector_preserves_active_profile_scope(api, tmp_path, monkeypatch):
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    record_usage_login_selection("anthropic", "first")
+    profile = tmp_path / "profile"
+    profile.mkdir()
+    token = set_hermes_home_override(profile)
+    try:
+        write_credential_pool("anthropic", [dict(id="profile-account", label="profile", priority=0,
+            source="manual:hermes_pkce", auth_type="oauth", access_token="fixture-profile")])
+        record_usage_login_selection("anthropic", "profile-account")
+        monkeypatch.setattr(api, "FETCH_ORDER", ("anthropic",))
+        with patch.object(api, "_http_json", return_value={"five_hour": {"utilization": 1.0}}):
+            result = api._collect()
+        assert result["providers"][0].get("credential_id") == "profile-account"
+    finally:
+        reset_hermes_home_override(token)
+
+
+def test_logout_selection_does_not_fall_back_to_other_account(api):
+    record_usage_login_selection("anthropic", "chosen")
+    clear_usage_login_selection("anthropic")
+    with patch.object(api, "_http_json") as get:
+        result = api.fetch_anthropic()
+    assert result["status"] == "unavailable"
+    get.assert_not_called()
